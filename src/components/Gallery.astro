---
import { Image } from 'astro:assets';
import heroPizza2 from '../assets/hero-pizza2.png';
import heroPizza3 from '../assets/hero-pizza3.png';
import heroPizza4 from '../assets/hero-pizza4.png';
import heroPizza5 from '../assets/hero-pizza5.png';
import menu1 from '../assets/menu-1.png';
import pizza from '../assets/pizza.png';
import story from '../assets/story.png';
import cta from '../assets/cta.png';
import pizza2 from '../assets/pizza2.png';

const images = [
	{ src: heroPizza3, alt: "Pizza recién horneada con queso derretido", class: "col-span-2 row-span-1" },
	{ src: heroPizza2, alt: "Porción de pizza con pepperoni", class: "row-span-2" },
	{ src: menu1, alt: "Pizza artesanal", class: "row-span-2" },
	{ src: pizza, alt: "Pizza horneada en horno de leña", class: "" },
	{ src: story, alt: "Detalle de pizza con ingredientes frescos", class: "row-span-2" },
	{ src: cta, alt: "Pizza lista para servir", class: "" },
	{ src: heroPizza5, alt: "Pizza estilo Chicago", class: "col-span-2 row-span-2" },
	{ src: heroPizza4, alt: "Ingrediente de pizza", class: "" },
	{ src: pizza2, alt: "Ingrediente de pizza", class: "" },
];
---

<section id="galeria" class="bg-cream">
	<div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
		<div class="mb-10 flex flex-wrap items-end gap-4">
			<h2 class="flex items-center gap-3 font-display text-3xl font-black tracking-wide sm:text-4xl">
				NUESTRA GALERÍA <span class="text-primary">★</span>
			</h2>
		</div>

		<div class="grid grid-flow-dense auto-rows-[140px] grid-cols-2 gap-4 sm:auto-rows-[160px] sm:grid-cols-4 lg:auto-rows-[180px]">
			{images.map((img) => (
				<div class:list={["group overflow-hidden rounded-2xl", img.class]}>
					<Image
						src={img.src}
						alt={img.alt}
						class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
					/>
				</div>
			))}
		</div>
	</div>
</section>
