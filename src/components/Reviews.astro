---
const reviews = [
	{
		name: "María G.",
		quote: "La mejor pizza estilo Chicago que he probado fuera de Chicago. La masa es increíble y siempre llega calientita.",
		rating: 5,
	},
	{
		name: "Carlos R.",
		quote: "Ambiente acogedor y el servicio es excelente. Se nota el cuidado en cada detalle. Volveremos pronto.",
		rating: 5,
	},
	{
		name: "Ana L.",
		quote: "Ingredientes frescos y mucho sabor en cada bocado. La Cuatro Quesos es mi favorita, totalmente recomendado.",
		rating: 5,
	},
];

const starPath =
	'<path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.563.563 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.563.563 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"/>';
---

<section id="resenas" class="bg-ink">
	<div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
		<div class="mb-10 text-center">
			<p class="mb-2 text-sm font-bold tracking-[0.2em] text-primary">RESEÑAS</p>
			<h2 class="font-display text-3xl font-black tracking-wide text-cream sm:text-4xl">
				LO QUE DICEN <span class="text-primary">NUESTROS CLIENTES.</span>
			</h2>
		</div>

		<div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
			{reviews.map((r) => (
				<div class="rounded-2xl border border-cream/10 bg-cream/5 p-6">
					<div class="flex gap-1 text-primary">
						{Array.from({ length: r.rating }).map(() => (
							<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" set:html={starPath} />
						))}
					</div>
					<p class="mt-4 text-sm leading-relaxed text-cream/80">&ldquo;{r.quote}&rdquo;</p>
					<p class="mt-4 font-display text-sm font-bold tracking-wide text-cream">{r.name}</p>
				</div>
			))}
		</div>
	</div>
</section>
