---
const features = [
	{
		title: "INGREDIENTES FRESCOS",
		desc: "Usamos los ingredientes más frescos y de origen local para un sabor excepcional.",
		icon: "leaf",
	},
	{
		title: "HORNO DE LEÑA",
		desc: "Nuestras pizzas se cocinan en un horno tradicional de leña para lograr la corteza perfecta.",
		icon: "flame",
	},
	{
		title: "RECETAS AUTÉNTICAS",
		desc: "Recetas italianas tradicionales transmitidas de generación en generación.",
		icon: "slice",
	},
	{
		title: "HECHO CON AMOR",
		desc: "Cada pizza se elabora con pasión y se sirve con una sonrisa.",
		icon: "heart",
	},
];

const icons: Record<string, string> = {
	leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
	flame: '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>',
	slice: '<path d="M3 11 12 3l9 8-9 12L3 11Z"/><circle cx="12" cy="10" r="1"/><circle cx="9" cy="13" r="1"/><circle cx="15" cy="13" r="1"/>',
	heart: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
};
---

<section class="bg-forest">
	<div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-6 py-10 sm:grid-cols-2 lg:grid-cols-4 lg:px-10">
		{features.map((f) => (
			<div class="flex items-start gap-4">
				<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#f7ede1" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0" set:html={icons[f.icon]} />
				<div>
					<h3 class="font-display text-sm font-bold tracking-wide text-cream">{f.title}</h3>
					<p class="mt-1.5 text-xs leading-relaxed text-cream/70">{f.desc}</p>
				</div>
			</div>
		))}
	</div>
</section>
