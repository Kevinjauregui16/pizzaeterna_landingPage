---
const address = "Av. Camino Real a Colima 220a, Los Gavilanes, 45645 Los Gavilanes, Jal.";
const mapSrc = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3735.516220919329!2d-103.44582732397426!3d20.566965903477843!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8428ad005b97bf51%3A0x77604406121890e3!2sPizz%C3%86terna!5e0!3m2!1ses-419!2smx!4v1786944668434!5m2!1ses-419!2smx";

const hours = [
	{ day: "Lun – Jue", time: "11:00 AM – 10:00 PM" },
	{ day: "Vie – Sáb", time: "11:00 AM – 11:00 PM" },
	{ day: "Domingo", time: "11:00 AM – 9:30 PM" },
];

const contactItems = [
	{ label: address, icon: "pin" },
	{ label: "(239) 555-1234", icon: "phone" },
	{ label: "hola@pizzaeterna.com", icon: "mail" },
];

const icons: Record<string, string> = {
	pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
	phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>',
	mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>',
	clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
};
---

<section id="ubicacion" class="bg-cream">
	<div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:px-10">
		<div>
			<p class="mb-2 flex items-center gap-2 text-sm font-bold tracking-[0.2em] text-primary">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.pin} />
				VISÍTANOS
			</p>
			<h2 class="font-display text-4xl font-black leading-tight sm:text-5xl">
				ENCUÉNTRANOS <span class="text-primary">CERCA DE TI.</span>
			</h2>
			<p class="mt-6 max-w-lg text-base leading-relaxed text-ink/70">
				Visítanos en nuestro local o contáctanos para hacer tu pedido. Te esperamos con el mejor sabor italiano.
			</p>

			<ul class="mt-8 space-y-4">
				{contactItems.map((item) => (
					<li class="flex items-center gap-3">
						<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary/10 text-primary">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
						</span>
						<span class="text-sm text-ink/70">{item.label}</span>
					</li>
				))}
			</ul>

			<div class="mt-8">
				<h4 class="flex items-center gap-2 font-display text-sm font-bold tracking-wide text-ink">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" set:html={icons.clock} />
					HORARIO
				</h4>
				<ul class="mt-4 max-w-xs space-y-2.5 text-sm text-ink/70">
					{hours.map((h) => (
						<li class="flex justify-between gap-4">
							<span>{h.day}</span>
							<span>{h.time}</span>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div class="aspect-[4/3] w-full overflow-hidden rounded-2xl shadow-xl lg:aspect-auto lg:h-full lg:min-h-[420px]">
			<iframe
				src={mapSrc}
				class="h-full w-full border-0"
				loading="lazy"
				allowfullscreen
				referrerpolicy="strict-origin-when-cross-origin"
				title="Ubicación de Pizza Eterna"
			></iframe>
		</div>
	</div>
</section>
