---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { whatsappUrl } from '../lib/whatsapp';

const navLinks = [
	{ label: "Inicio", href: "#inicio" },
	{ label: "Nosotros", href: "#historia" },
	{ label: "Menú", href: "#menu" },
	// { label: "Especiales", href: "#menu" },
	{ label: "Galería", href: "#galeria" },
	{ label: "Reseñas", href: "#resenas" },
	{ label: "Contacto", href: "#ubicacion" },
];
---

<header class="sticky top-0 z-50 bg-ink/95 backdrop-blur border-b border-cream/10">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10">
		<a href="#inicio" class="flex items-center">
			<Image src={logo} alt="Pizza Eterna &mdash; Chicago Style, MMXXV" class="h-14 w-auto sm:h-16" width={898} height={325} />
		</a>

		<nav class="hidden items-center gap-8 lg:flex">
			{navLinks.map((link) => (
				<a
					href={link.href}
					data-nav-link
					class="border-b-2 border-transparent pb-1 text-sm font-semibold tracking-wide text-cream/80 transition-colors hover:text-primary"
				>
					{link.label.toUpperCase()}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-3">
			<a
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-cream shadow-sm hover:bg-primary-dark transition-colors sm:flex"
			>
				ORDENAR AHORA
			</a>
			<button
				id="menu-toggle"
				class="grid h-10 w-10 place-items-center rounded-md border border-cream/15 text-cream lg:hidden"
				aria-label="Abrir menú"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
			</button>
		</div>
	</div>

	<nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-cream/10 bg-ink px-6 py-4 lg:hidden">
		{navLinks.map((link) => (
			<a href={link.href} data-nav-link class="rounded-md px-3 py-2 text-sm font-semibold text-cream/80 hover:bg-cream/5 hover:text-primary">
				{link.label.toUpperCase()}
			</a>
		))}
		<a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-2 rounded-md bg-primary px-4 py-2.5 text-center text-sm font-semibold text-cream">
			ORDENAR X WHATSAPP
		</a>
	</nav>
</header>

<script>
	const toggle = document.getElementById("menu-toggle");
	const menu = document.getElementById("mobile-menu");
	toggle?.addEventListener("click", () => {
		menu?.classList.toggle("hidden");
		menu?.classList.toggle("flex");
	});

	const navLinks = Array.from(document.querySelectorAll("[data-nav-link]"));

	const sections = navLinks
		.map((link) => {
			const id = link.getAttribute("href")?.slice(1);
			const section = id ? document.getElementById(id) : null;
			return section ? { id, section } : null;
		})
		.filter((entry) => entry !== null);

	function setActiveLink(id : string) {
		navLinks.forEach((link) => {
			const isActive = link.getAttribute("href") === `#${id}`;
			const isUnderlined = link.classList.contains("border-b-2");
			link.classList.toggle("text-primary", isActive);
			link.classList.toggle("text-cream/80", !isActive);
			if (isUnderlined) {
				link.classList.toggle("border-primary", isActive);
				link.classList.toggle("border-transparent", !isActive);
			}
		});
	}

	if (sections.length) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						setActiveLink(entry.target.id);
					}
				});
			},
			{ rootMargin: "-45% 0px -50% 0px", threshold: 0 }
		);
		sections.forEach(({ section }) => observer.observe(section));
	}
</script>
