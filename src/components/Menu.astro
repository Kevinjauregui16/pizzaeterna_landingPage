---
import { Image } from 'astro:assets';
import menu1 from '../assets/menu-1.png';
import peperoni from '../assets/peperoni.png';
import quesos from '../assets/4quesos.png';
import arugula from '../assets/arugula.png';
import vegetarian from '../assets/vegetariana.png';
import diavola from '../assets/diavola.png';
import pizza1 from '../assets/pizza.png';
import pizza2 from '../assets/pizza2.png';
import heroPizza2 from '../assets/hero-pizza2.png';
import heroPizza3 from '../assets/hero-pizza3.png';
import heroPizza4 from '../assets/hero-pizza4.png';
import mineral from '../assets/mineral.png';
import refresco from '../assets/refresco.png';
import limonada from '../assets/limonada.png';
import cerveza from '../assets/cerveza.png';
import vino from '../assets/vino.png';
import coca from '../assets/coca.png';

const pizzas = [
	{ name: "Margherita", desc: "Salsa de tomate San Marzano, mozzarella fresca, albahaca, aceite de oliva extra virgen.", price: "13.99", tint: "bg-cream-dark", src: menu1 },
	{ name: "Pepperoni", desc: "Salsa San Marzano, mozzarella, pepperoni premium.", price: "14.99", tint: "bg-primary/10", src: peperoni },
	{ name: "Cuatro Quesos", desc: "Mozzarella, gorgonzola, parmesano, fontina, miel de trufa.", price: "15.99", tint: "bg-cream-dark", src: quesos },
	{ name: "Prosciutto y Rúgula", desc: "Salsa San Marzano, mozzarella, prosciutto, rúgula, parmesano.", price: "16.99", tint: "bg-forest/10", src: arugula },
	{ name: "Delicia Vegetariana", desc: "Salsa San Marzano, mozzarella, pimientos, aceitunas, champiñones.", price: "14.99", tint: "bg-cream-dark", src: vegetarian },
	{ name: "Diavola", desc: "Salsa San Marzano, mozzarella, salami picante calabrés.", price: "15.99", tint: "bg-primary/10", src: diavola },
];

const morePizzas = [
	{ name: "Especial de la Casa", desc: "Salsa San Marzano, mozzarella, salchicha italiana, pimientos asados, cebolla caramelizada.", price: "17.99", tint: "bg-primary/10", src: pizza1 },
	{ name: "Cuatro Carnes", desc: "Salsa San Marzano, mozzarella, pepperoni, salchicha, prosciutto, tocino.", price: "18.99", tint: "bg-cream-dark", src: pizza2 },
	{ name: "Hawaiana", desc: "Salsa San Marzano, mozzarella, jamón, piña asada.", price: "14.99", tint: "bg-forest/10", src: heroPizza2 },
	{ name: "Setas y Trufa", desc: "Crema de ajo, mozzarella, mezcla de champiñones, aceite de trufa, parmesano.", price: "17.99", tint: "bg-primary/10", src: heroPizza3 },
	{ name: "Pesto Caprese", desc: "Pesto de albahaca, mozzarella fresca, tomates cherry, parmesano.", price: "15.99", tint: "bg-cream-dark", src: heroPizza4 },
];

const drinks = [
	{ name: "Agua Mineral", desc: "Botella 500ml, con o sin gas.", price: "2.50", tint: "bg-cream-dark", src: mineral},
	{ name: "Refresco Italiano", desc: "Naranja, limón o manzana.", price: "3.50", tint: "bg-primary/10", src: refresco},
	{ name: "Limonada Casera", desc: "Preparada al momento con menta fresca.", price: "3.99", tint: "bg-forest/10", src: limonada },
	{ name: "Cerveza Artesanal", desc: "Selección local, botella 355ml.", price: "5.99", tint: "bg-cream-dark", src: cerveza },
	{ name: "Vino Tinto de la Casa", desc: "Copa, blend italiano.", price: "6.99", tint: "bg-primary/10", src: vino },
	{ name: "Coca-Cola", desc: "Lata 355ml.", price: "2.99", tint: "bg-forest/10", src: coca},
];
---

<section id="menu" class="bg-cream">
	<div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
		<div class="mb-10 flex flex-wrap items-end gap-4">
			<h2 class="flex items-center gap-3 font-display text-3xl font-black tracking-wide sm:text-4xl">
			LOS DESTACADOS <span class="text-primary">★</span>
			</h2>
			<button type="button" id="toggle-menu-completo" aria-expanded="false" aria-controls="menu-completo" class="ml-auto flex shrink-0 items-center gap-1 text-sm font-semibold tracking-wide text-primary hover:underline">
				<span id="toggle-menu-completo-label">VER MENÚ COMPLETO</span>
				<span id="toggle-menu-completo-icon" class="transition-transform duration-300">&rarr;</span>
			</button>
		</div>

		<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{pizzas.map((p) => (
				<div class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-ink/5 transition-shadow hover:shadow-lg">
					<div class:list={["flex aspect-square items-center justify-center overflow-hidden", p.tint]}>
						<Image src={p.src} alt={p.name} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" width={736} height={1104} />
					</div>
					<div class="p-5">
						<h3 class="font-display text-base font-bold tracking-wide">{p.name.toUpperCase()}</h3>
						<p class="mt-1.5 text-xs leading-relaxed text-ink/60">{p.desc}</p>
						<div class="mt-4 flex items-center">
							<span class="font-display text-lg font-bold text-primary">${p.price}</span>
						</div>
					</div>
				</div>
			))}
		</div>

		<div id="menu-completo" class="hidden">
			<h3 class="mb-6 mt-14 font-display text-2xl font-black tracking-wide">MÁS DE NUESTRO MENÚ</h3>
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{morePizzas.map((p) => (
					<div class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-ink/5 transition-shadow hover:shadow-lg">
						<div class:list={["flex aspect-square items-center justify-center overflow-hidden", p.tint]}>
							<Image src={p.src} alt={p.name} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" width={736} height={1104} />
						</div>
						<div class="p-5">
							<h3 class="font-display text-base font-bold tracking-wide">{p.name.toUpperCase()}</h3>
							<p class="mt-1.5 text-xs leading-relaxed text-ink/60">{p.desc}</p>
							<div class="mt-4 flex items-center">
								<span class="font-display text-lg font-bold text-primary">${p.price}</span>
							</div>
						</div>
					</div>
				))}
			</div>

			<h3 class="mb-6 mt-14 font-display text-2xl font-black tracking-wide">BEBIDAS</h3>
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{drinks.map((d) => (
					<div class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-ink/5 transition-shadow hover:shadow-lg">
						<div class:list={["flex aspect-square items-center justify-center overflow-hidden", d.tint]}>
								<Image src={d.src} alt={d.name} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" width={736} height={1104} />
						</div>
						<div class="p-5">
							<h3 class="font-display text-base font-bold tracking-wide">{d.name.toUpperCase()}</h3>
							<p class="mt-1.5 text-xs leading-relaxed text-ink/60">{d.desc}</p>
							<div class="mt-4 flex items-center">
								<span class="font-display text-lg font-bold text-primary">${d.price}</span>
							</div>
						</div>
					</div>
				))}
			</div>

			<div class="mt-10 flex justify-center">
				<button type="button" id="toggle-menu-completo-bottom" class="flex shrink-0 items-center gap-1 text-sm font-semibold tracking-wide text-primary hover:underline">
					<span>VER MENOS</span>
					<span class="transition-transform duration-300">&uarr;</span>
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	const toggleBtn = document.getElementById('toggle-menu-completo');
	const toggleBtnBottom = document.getElementById('toggle-menu-completo-bottom');
	const panel = document.getElementById('menu-completo');
	const label = document.getElementById('toggle-menu-completo-label');
	const icon = document.getElementById('toggle-menu-completo-icon');
	const menuSection = document.getElementById('menu');

	function setExpanded(expanded: boolean) {
		panel?.classList.toggle('hidden', !expanded);
		toggleBtn?.setAttribute('aria-expanded', String(expanded));
		if (label) label.textContent = expanded ? 'VER MENOS' : 'VER MENÚ COMPLETO';
		if (icon) icon.textContent = expanded ? '↑' : '→';
	}

	toggleBtn?.addEventListener('click', () => {
		const expanded = panel?.classList.contains('hidden');
		setExpanded(!!expanded);
		if (expanded) panel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});

	toggleBtnBottom?.addEventListener('click', () => {
		setExpanded(false);
		menuSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
</script>
